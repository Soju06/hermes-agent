#!/usr/bin/env bash
# hermes-venv-rebuild — rebuild the live hermes-agent tree's Python environment from its own lock.
#
# Since the v0.22.5 base (2026-10-30 sync) upstream pins EVERY runtime dependency behind
# `python_version >= '3.14'` and manages environments through `pm` (pm/AGENTS.md): a plain
# `uv pip install -e .` on the 3.12 interpreter installs nothing, and `dev`/`test` are
# dependency-groups, not extras. The sanctioned build is `python -m pm.build_env`, which
# installs from uv.lock (exact pins, overrides, markers) and records the extras as the
# runtime selection PM expects.
#
# Use after switching git branches in ~/.hermes/hermes-agent/ or after a sync.
# DOES NOT restart any gateway. Stop the gateways first: the build removes and recreates $VENV.

set -euo pipefail

LIVE_TREE="${LIVE_TREE:-$HOME/.hermes/hermes-agent}"
VENV="${VENV:-$LIVE_TREE/venv}"
PY314="${HERMES_BUILD_PYTHON:-$(ls -d "$HOME"/.local/share/uv/python/cpython-3.14*-linux-x86_64-gnu/bin/python3.14 2>/dev/null | tail -1)}"
EXTRAS=(${HERMES_VENV_EXTRAS:-messaging slack anthropic})   # platform extras this host uses

if [[ ! -d "$LIVE_TREE" ]]; then
    echo "FATAL: live tree not found at $LIVE_TREE" >&2
    exit 1
fi
if [[ -z "$PY314" || ! -x "$PY314" ]]; then
    echo "FATAL: no CPython 3.14 found (uv python install 3.14, or set HERMES_BUILD_PYTHON)" >&2
    exit 1
fi

cd "$LIVE_TREE"
echo "Live tree branch: $(git rev-parse --abbrev-ref HEAD) @ $(git rev-parse --short HEAD)"
echo "Build python:     $PY314 ($("$PY314" --version))"
echo "Extras:           ${EXTRAS[*]}  (+ dependency groups dev, test)"

if pgrep -f "$VENV/bin/python" >/dev/null 2>&1; then
    echo "FATAL: processes are still running from $VENV — stop the gateways first" >&2
    pgrep -af "$VENV/bin/python" | head -5 >&2
    exit 2
fi

extra_args=()
for e in "${EXTRAS[@]}"; do extra_args+=(--extra "$e"); done
# Fresh build (pm.build_env refuses an in-place sync); --record-selection publishes the extras as the
# runtime selection so a later `hermes pm` sync extends rather than replaces the environment.
nice -n 10 "$PY314" -m pm.build_env --source . --out "$VENV" --python "$PY314" \
    --group dev --group test "${extra_args[@]}" --explicit --record-selection

# Sanity
"$VENV/bin/python" --version
"$VENV/bin/python" -c "import run_agent, gateway.run, tools.delegate_tool; print('import OK')"
uv pip check --python "$VENV/bin/python" || echo "WARN: pip check reported problems (known on v0.22.5: browser-harness pins pillow==12.3.0 while the lock installs 13.0.0)"

echo
echo "Done. Next (one at a time, after reading the sync report's deploy notes):"
echo "  venv/bin/python -c 'from hermes_state import SessionDB; SessionDB()'   # pre-warm the one-time FTS realign per profile"
echo "  hermes config migrate  (per profile, on copies first)"
echo "  hermes --profile <name> gateway --replace"
